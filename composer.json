{
    "name": "bliptrace/drupal",
    "version": "1.0.0",
    "description": "Drupal 10/11 module for Bliptrace — auto-captures exceptions via an event subscriber and ships them to the ingest API. Thin adapter over bliptrace/php.",
    "keywords": [
        "drupal",
        "drupal-module",
        "bliptrace",
        "error-tracking",
        "observability",
        "sdk"
    ],
    "type": "drupal-module",
    "license": "MIT",
    "require": {
        "php": "^8.2",
        "bliptrace/php": "^2.0"
    },
    "require-dev": {
        "pestphp/pest": "^3.0",
        "laravel/pint": "^1.0",
        "symfony/http-kernel": "^6.4|^7.0"
    },
    "suggest": {
        "drupal/core": "^10 || ^11"
    },
    "autoload": {
        "psr-4": {
            "Bliptrace\\Drupal\\": "src/",
            "Drupal\\bliptrace\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Bliptrace\\Drupal\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "vendor/bin/pest",
        "lint": "vendor/bin/pint"
    },
    "repositories": [
        {
            "type": "path",
            "url": "../bliptrace-php",
            "options": {
                "symlink": true,
                "versions": { "bliptrace/php": "2.0.0" }
            }
        }
    ],
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
